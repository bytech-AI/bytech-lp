# microCMS REST API settings for biz.bytech.jp/news
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-read-api-key
MICROCMS_NEWS_ENDPOINT=news
# お役立ち資料（/documents）用エンドポイント。スキーマ: docs/microcms-documents-schema.md
MICROCMS_DOCUMENTS_ENDPOINT=documents

# --- リブランディング用ベースライン取得 (scripts/analytics-baseline.mjs) ---
# GSC・GA4 共通: サービスアカウント鍵JSONのパス（GSC/GA4 側に client_email を閲覧者で追加）
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/ga-service-account.json
# GSC プロパティ（カンマ区切り）
GSC_SITE_URLS=sc-domain:bytech.jp
# GA4 プロパティID（数字のみ、カンマ区切り）
GA4_PROPERTY_IDS=
GA4_PROPERTY_LABELS=
# Clarity Data Export API トークン（プロジェクト設定 > Data Export）、複数はカンマ区切り
CLARITY_API_TOKEN=
CLARITY_PROJECT_LABELS=home,counseling
# KPI週報の投稿先 Discord Webhook（scripts/kpi-discord.mjs / GitHub Actions では secrets）
DISCORD_KPI_WEBHOOK_URL=
